import java.util.Scanner;

public class Main {

    public static void main(String[] args) {

        Scanner scanner = new Scanner(System.in);

        System.out.print("Podaj liczbe oczek dla pierwszej kosci: ");
        int liczba = scanner.nextInt();

        Kosc kosc1 = new Kosc(liczba);

        System.out.println();
        System.out.println("Pierwsza kosc:");
        System.out.println("Liczba utworzonych instancji: " + Kosc.liczbaInstancji);
        System.out.println("Liczba oczek: " + kosc1.liczbaOczek);
        System.out.println("Liczba oczek slownie: " + kosc1.pokazLiczbe());
        System.out.println("Nazwa pliku: " + kosc1.nazwyPlikow[kosc1.identyfikatorPliku]);

        Kosc kosc2 = new Kosc();

        System.out.println();
        System.out.println("Druga kosc:");
        System.out.println("Liczba utworzonych instancji: " + Kosc.liczbaInstancji);
        System.out.println("Liczba oczek: " + kosc2.liczbaOczek);
        System.out.println("Liczba oczek slownie: " + kosc2.pokazLiczbe());
        System.out.println("Nazwa pliku: " + kosc2.nazwyPlikow[kosc2.identyfikatorPliku]);

        scanner.close();
    }
}


