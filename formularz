import javax.swing.*;
import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;

public class NWD {
    private JPanel panelGlowny;
    private JButton obliczNWDButton;
    private JTextField textField1;
    private JTextField textField2;
    private JPanel wynik;
    private JLabel wynik2;

    public NWD() {
        obliczNWDButton.addActionListener(new ActionListener() {
            @Override
            public void actionPerformed(ActionEvent e) {
                int a = Integer.parseInt(textField1.getText());
                int b = Integer.parseInt(textField2.getText());
                int w = Main.NWD(a, b);
                wynik2.setText("NWD wynosi: " + w);

            }
        });
    }

    public static void main(String[] args) {
        JFrame frame = new JFrame("NWD");
        frame.setContentPane(new NWD().panelGlowny);
        frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        frame.pack();
        frame.setSize(600,300);
        frame.setLocationRelativeTo(null);
        frame.setVisible(true);
    }

}

